# Potenova environment template — copy to .env (never commit real values).
# SEC-002: each environment uses SEPARATE credentials/keys/databases/provider access.

# One of: dev | test | qa | staging | prod
# dev → qa → prod is the promotion path (ADR-0020); only prod may ever carry
# real child data, and not before the G2 gate.
APP_ENV=dev

# Canada-resident regions only (fail-closed). B9 residency boundary.
PRIMARY_REGION=ca-central
DR_REGION=ca-east

# Dev HTTP probe port (WP-00 only serves /healthz, /readyz).
PORT=8080

# --- Secrets are injected per environment, NOT stored here ---
# DATABASE_URL=
# AI_GATEWAY_KEY=
# OBJECT_STORE_KEY=
