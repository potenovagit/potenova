{
  "name": "@potenova/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch --tsconfig ../../tsconfig.dev.json src/dev.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --outfile=dist/server.mjs --external:pg --external:@electric-sql/pglite --external:drizzle-orm --external:hono --external:@hono/node-server --external:jose"
  },
  "devDependencies": {
    "esbuild": "0.23.1"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@potenova/ai-gateway": "*",
    "@potenova/billing": "*",
    "@potenova/config": "*",
    "@potenova/content": "*",
    "@potenova/contracts": "*",
    "@potenova/curriculum": "*",
    "@potenova/diagnostic": "*",
    "@potenova/planner": "*",
    "@potenova/domain-core": "*",
    "@potenova/identity": "*",
    "@potenova/learner-state": "*",
    "@potenova/parent": "*",
    "@potenova/policy": "*",
    "@potenova/safety": "*",
    "@potenova/persistence": "*",
    "hono": "4.13.13",
    "jose": "5.9.6"
  }
}
