# dependencies
node_modules/

# build output
dist/
*.tsbuildinfo

# env / secrets — never commit (SEC-002: separate per-environment credentials)
.env
.env.*
!.env.example

# logs / local
*.log
.DS_Store

# local database data (PGlite dev/demo) — never commit; prod is managed Postgres
.data/
**/.data/
*.pgdata

# Bicep parameter file with real secrets (keep main.sample.bicepparam only)
infra/azure/main.bicepparam
# compiled Bicep output (generated by `az bicep build`)
infra/azure/*.json

# generated evidence runs (keep structure + README, ignore large run artifacts)
evidence/**/run-*/
