{
  "name": "potenova",
  "version": "0.0.0",
  "private": true,
  "description": "Potenova platform monorepo — WP-00 engineering foundation (no child-facing features).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "trace": "tsx packages/requirement-trace/src/cli.ts --csv spec/requirements.csv",
    "trace:evidence": "tsx packages/requirement-trace/src/cli.ts --csv spec/requirements.csv --out evidence/WP-00/requirement-trace.json",
    "demo:persist": "tsx packages/persistence/demo/persist-demo.ts",
    "build:web": "npm run build --workspace @potenova/web",
    "build:api": "npm run build --workspace @potenova/api",
    "dev:api": "npm run dev --workspace @potenova/api",
    "dev:web": "npm run dev --workspace @potenova/web",
    "eval:model": "tsx --tsconfig tsconfig.dev.json services/api/src/eval-cli.ts",
    "gate:dryrun": "tsx --tsconfig tsconfig.dev.json services/api/src/gate-dryrun-cli.ts",
    "er03:evidence": "tsx --tsconfig tsconfig.dev.json services/api/src/er03-evidence-cli.ts",
    "overlay:worksheet": "tsx scripts/build-overlay-worksheet.ts",
    "overlay:review": "tsx scripts/review-overlay-worksheet.ts",
    "ci": "npm run format:check && npm run typecheck && npm run test && npm run trace && npm run build:web && npm run build:api"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "prettier": "3.4.2",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
